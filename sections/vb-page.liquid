{%- comment -%} Vow Buddy standard page: title as a small italic line, first heading in the body is the headline {%- endcomment -%}
<style>
.vbp{font-family:Figtree,system-ui,sans-serif;color:#1c211e;background:#f6f3ec;line-height:1.55}
.vbp-wrap{max-width:760px;margin:0 auto;padding:56px 24px 88px}
.vbp-eyebrow{font-family:Fraunces,Georgia,serif;font-style:italic;font-size:20px;color:#b9975b;margin:0 0 10px}
.vbp-body h2{font-family:Fraunces,Georgia,serif;font-weight:500;font-size:clamp(34px,4.4vw,52px);line-height:1.05;letter-spacing:-.5px;margin:0 0 22px}
.vbp-body h2 + h2{margin-top:48px}
.vbp-body h3{font-family:Fraunces,Georgia,serif;font-weight:500;font-size:26px;line-height:1.15;margin:34px 0 8px}
.vbp-body p{font-size:17px;color:#2f3531;margin:0 0 16px;max-width:66ch}
.vbp-body ul{margin:0 0 18px;padding-left:22px;font-size:16.5px;color:#2f3531}
.vbp-body li{margin:4px 0}
.vbp-body em{color:#4f5753}
.vbp-body a{color:#173b31;text-decoration:underline;text-decoration-color:#b9975b;text-underline-offset:3px;font-weight:600}
.vbp-body a:hover{color:#2f6b57}
.vbp-body p:has(> a:first-child:last-child) a,.vbp-body p > a.vbp-cta{display:inline-flex;align-items:center;height:48px;padding:0 24px;border-radius:999px;background:#173b31;color:#f3efe6;text-decoration:none;font-weight:600;margin:6px 10px 6px 0}
.vbp-body p:has(> a:first-child:last-child) a:hover{background:#1f4a3d;color:#f3efe6}
.vbp-body hr{border:0;border-top:1px solid #e2dccf;margin:40px 0}
</style>
<div class="vbp">
  <div class="vbp-wrap">
    <p class="vbp-eyebrow">{{ page.title }}</p>
    <div class="vbp-body">{{ page.content }}</div>
  </div>
</div>
{% schema %}
{ "name": "Vow Buddy page", "settings": [], "presets": [ { "name": "Vow Buddy page" } ] }
{% endschema %}
